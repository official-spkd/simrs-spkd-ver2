# Alamat backend (simrs-api) yang dipanggil browser pengguna — harus bisa dijangkau dari komputer/APM/TV, bukan hanya dari server.
NUXT_PUBLIC_API_BASE=http://localhost:8080

# Port frontend di host (docker compose). Origin-nya (mis. http://<ip-server>:3000) wajib masuk CORS_ALLOWED_ORIGINS backend.
WEB_PORT=3000
